{
  "name": "@nexora/desktop",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:expo\" \"wait-on http://localhost:19006 && npm run dev:electron\"",
    "dev:expo": "expo start --web",
    "dev:electron": "electron .",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "expo export --platform web",
    "build:electron": "electron-builder",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nexora.tasks",
    "productName": "Nexora Tasks",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "dist/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
